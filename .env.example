# --- Supabase (CameraGrail uses the `cameragrail` schema inside this project) ---
NEXT_PUBLIC_SUPABASE_URL=https://xbhewtoryhtguvlmodfi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_D7evHkcuiJcSWWDpilf16A_feSGgzsh
# Service role: server-side only, never expose. Required for cron + moderation.
SUPABASE_SERVICE_ROLE_KEY=

# --- eBay (mock in development, real creds in production) ---
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_OAUTH_TOKEN=
EBAY_MARKETPLACE_INSIGHTS_ENABLED=false
EPN_CAMPAIGN_ID=
# When unset, lib/ebay.ts falls back to deterministic mock data so the app runs.
EBAY_USE_MOCK=true

# --- Analytics ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cameragrail.com
NEXT_PUBLIC_CLARITY_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://cameragrail.com

# --- Feature flags ---
# Hides the price-history chart on a per-camera basis until it has at least
# NEXT_PUBLIC_PRICE_HISTORY_MIN_POINTS data points.
NEXT_PUBLIC_PRICE_HISTORY_MIN_POINTS=4
